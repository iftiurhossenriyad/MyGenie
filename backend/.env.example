# PostgreSQL Database
# Prefer DATABASE_URL for hosted deployments. It can use postgres:// or postgresql://.
# The app will fail explicitly if the configured database is unavailable.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mygenie

# JWT Security
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Provider (optional)
# Options: mock, gemini, openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash